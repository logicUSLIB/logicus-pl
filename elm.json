{
    "type": "package",
    "name": "logicUSLIB/logicus-pl",
    "summary": "Elm package for working with Propositional Logic.",
    "license": "BSD-3-Clause",
    "version": "4.2.0",
    "exposed-modules": [
        "LogicUS.PL.SyntaxSemantics",
        "LogicUS.PL.SemanticTableaux",
        "LogicUS.PL.NormalForms",
        "LogicUS.PL.Clauses",
        "LogicUS.PL.DPLL",
        "LogicUS.PL.Resolution",
        "LogicUS.PL.CSP",
        "LogicUS.PL.HornRS",
        "LogicUS.PL.Deduction",
        "LogicUS.PL.DeductionSystems"
    ],
    "elm-version": "0.19.1 <= v < 0.19.2",
    "dependencies": {
        "elm/core": "1.0.5 <= v < 2.0.0",
        "elm/json": "1.1.3 <= v < 2.0.0",
        "elm/parser": "1.1.0 <= v < 2.0.0",
        "elm-community/graph": "6.0.0 <= v < 7.0.0",
        "elm-community/intdict": "3.0.0 <= v < 4.0.0",
        "elm-community/list-extra": "8.3.0 <= v < 9.0.0",
        "elm-community/maybe-extra": "5.2.0 <= v < 6.0.0",
        "elm-community/string-extra": "4.0.1 <= v < 5.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.2.0 <= v < 3.0.0"
    }
}
